&i2c4 {
    status = "okay";
};

&i2c5 {
    status = "okay";

    eeprom5_1: eeprom@55 {
        compatible = "zephyr,i2c-target-eeprom";
        reg = <0x55>;
        size = <256>;
        status = "okay";
    };
};

&i2c6 {
    status = "okay";

    eeprom6_1: eeprom@66 {
        compatible = "zephyr,i2c-target-eeprom";
        reg = <0x66>;
        size = <256>;
        status = "okay";
    };
};
