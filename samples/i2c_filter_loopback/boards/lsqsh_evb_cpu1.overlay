#include "lsqsh_pinctrl_pfr_tpm.dtsi"

/ {
    aliases {
        i2cmaster1 = &i2c5;
        i2cmaster2 = &i2c6;
        i2cfilter = &i2cf4;
        i2ceepromlocal = &eeprom5_1;
        i2ceepromremote = &eeprom6_1;
    };
};

