        input-enable;
    };
    /omit-if-no-ref/spif3_io0_out_pf05: spif3_io0_out_pf05 {
        pinmux = <SPIF3_IO0_OUT_FUNC4_PF05_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif3_io3_in_pf06: spif3_io3_in_pf06 {
        pinmux = <SPIF3_IO3_IN_FUNC4_PF06_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif3_io3_out_pf07: spif3_io3_out_pf07 {
        pinmux = <SPIF3_IO3_OUT_FUNC4_PF07_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif3_clk_in_pf08: spif3_clk_in_pf08 {
        pinmux = <SPIF3_CLK_IN_FUNC4_PF08_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif3_clk_out_pf09: spif3_clk_out_pf09 {
        pinmux = <SPIF3_CLK_OUT_FUNC4_PF09_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif3_io2_in_pf10: spif3_io2_in_pf10 {
        pinmux = <SPIF3_IO2_IN_FUNC4_PF10_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif3_io2_out_pf11: spif3_io2_out_pf11 {
        pinmux = <SPIF3_IO2_OUT_FUNC4_PF11_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif4_io2_in_pf12: spif4_io2_in_pf12 {
        pinmux = <SPIF4_IO2_IN_FUNC4_PF12_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif1_io1_out_pf13: spif1_io1_out_pf13 {
        pinmux = <SPIF1_IO1_OUT_FUNC4_PF13_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif1_io0_in_pf14: spif1_io0_in_pf14 {
        pinmux = <SPIF1_IO0_IN_FUNC4_PF14_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif1_io0_out_pf15: spif1_io0_out_pf15 {
        pinmux = <SPIF1_IO0_OUT_FUNC4_PF15_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif1_clk_out_pg00: spif1_clk_out_pg00 {
        pinmux = <SPIF1_CLK_OUT_FUNC4_PG00_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif4_io2_out_pg01: spif4_io2_out_pg01 {
        pinmux = <SPIF4_IO2_OUT_FUNC4_PG01_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif1_clk_in_pg04: spif1_clk_in_pg04 {
        pinmux = <SPIF1_CLK_IN_FUNC4_PG04_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif4_io3_out_pg05: spif4_io3_out_pg05 {
        pinmux = <SPIF4_IO3_OUT_FUNC4_PG05_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif1_io1_in_pg06: spif1_io1_in_pg06 {
        pinmux = <SPIF1_IO1_IN_FUNC4_PG06_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif4_io3_in_pg07: spif4_io3_in_pg07 {
        pinmux = <SPIF4_IO3_IN_FUNC4_PG07_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif2_clk_in_pg08: spif2_clk_in_pg08 {
        pinmux = <SPIF2_CLK_IN_FUNC4_PG08_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif2_clk_out_pg09: spif2_clk_out_pg09 {
        pinmux = <SPIF2_CLK_OUT_FUNC4_PG09_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif2_io3_in_pg12: spif2_io3_in_pg12 {
        pinmux = <SPIF2_IO3_IN_FUNC4_PG12_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif2_io3_out_pg13: spif2_io3_out_pg13 {
        pinmux = <SPIF2_IO3_OUT_FUNC4_PG13_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif2_io2_in_pg14: spif2_io2_in_pg14 {
        pinmux = <SPIF2_IO2_IN_FUNC4_PG14_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif2_io2_out_pg15: spif2_io2_out_pg15 {
        pinmux = <SPIF2_IO2_OUT_FUNC4_PG15_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif1_io2_in_ph00: spif1_io2_in_ph00 {
        pinmux = <SPIF1_IO2_IN_FUNC4_PH00_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif1_io2_out_ph01: spif1_io2_out_ph01 {
        pinmux = <SPIF1_IO2_OUT_FUNC4_PH01_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif1_io3_in_ph02: spif1_io3_in_ph02 {
        pinmux = <SPIF1_IO3_IN_FUNC4_PH02_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif1_io3_out_ph03: spif1_io3_out_ph03 {
        pinmux = <SPIF1_IO3_OUT_FUNC4_PH03_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif2_io0_in_ph04: spif2_io0_in_ph04 {
        pinmux = <SPIF2_IO0_IN_FUNC4_PH04_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif2_io0_out_ph05: spif2_io0_out_ph05 {
        pinmux = <SPIF2_IO0_OUT_FUNC4_PH05_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif2_io1_in_ph06: spif2_io1_in_ph06 {
        pinmux = <SPIF2_IO1_IN_FUNC4_PH06_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif2_io1_out_ph07: spif2_io1_out_ph07 {
        pinmux = <SPIF2_IO1_OUT_FUNC4_PH07_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif4_io1_in_ph08: spif4_io1_in_ph08 {
        pinmux = <SPIF4_IO1_IN_FUNC4_PH08_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif4_io1_out_ph09: spif4_io1_out_ph09 {
        pinmux = <SPIF4_IO1_OUT_FUNC4_PH09_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif4_io0_in_ph10: spif4_io0_in_ph10 {
        pinmux = <SPIF4_IO0_IN_FUNC4_PH10_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif4_io0_out_ph11: spif4_io0_out_ph11 {
        pinmux = <SPIF4_IO0_OUT_FUNC4_PH11_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif4_clk_in_ph12: spif4_clk_in_ph12 {
        pinmux = <SPIF4_CLK_IN_FUNC4_PH12_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif4_clk_out_ph13: spif4_clk_out_ph13 {
        pinmux = <SPIF4_CLK_OUT_FUNC4_PH13_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif3_csn_out_pi00: spif3_csn_out_pi00 {
        pinmux = <SPIF3_CSN_OUT_FUNC4_PI00_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif1_csn_out_pi08: spif1_csn_out_pi08 {
        pinmux = <SPIF1_CSN_OUT_FUNC4_PI08_PINMUX>;
        input-enable;
    };

    /omit-if-no-ref/spi1_mst_csn_gpio_pi08: spi1_mst_csn_gpio_pi08 {
        pinmux = <PI08>;
        gpio;
        input-enable;
    };
    /omit-if-no-ref/spi2_mst_csn_gpio_pg02: spi2_mst_csn_gpio_pg02 {
        pinmux = <PG02>;
        gpio;
        input-enable;
    };
    /omit-if-no-ref/spi3_mst_csn_gpio_pi00: spi3_mst_csn_gpio_pi00 {
        pinmux = <PI00>;
        gpio;
        input-enable;
    };
    /omit-if-no-ref/spi4_mst_csn_gpio_pq00: spi4_mst_csn_gpio_pq00 {
        pinmux = <PQ00>;
        gpio;
        input-enable;
    };

    DEFINE_PINCTRL_PRODUCER_I2C(I2C1, PB06, PB10, I2C1_SCL_FUNC2_PB06_PINMUX, I2C1_SDA_FUNC2_PB10_PINMUX)
    DEFINE_PINCTRL_PRODUCER_I2C(I2C2, PB04, PB01, I2C2_SCL_FUNC2_PB04_PINMUX, I2C2_SDA_FUNC2_PB01_PINMUX)
    DEFINE_PINCTRL_PRODUCER_I2C(I2C3, PB15, PB14, I2C3_SCL_FUNC2_PB15_PINMUX, I2C3_SDA_FUNC2_PB14_PINMUX)
    DEFINE_PINCTRL_PRODUCER_I2C(I2C4, PE02, PB00, I2C4_SCL_FUNC2_PE02_PINMUX, I2C4_SDA_FUNC2_PB00_PINMUX)
};

&i2c1 {
    DEFINE_PINCTRL_CONSUMER_I2C(I2C1, PB06, PB10, gpiob, 6, gpiob, 10)
    pinctrl-noinit;
};

&i2c2 {
    DEFINE_PINCTRL_CONSUMER_I2C(I2C2, PB04, PB01, gpiob, 4, gpiob, 1)
    pinctrl-noinit;
};

&i2c3 {
    DEFINE_PINCTRL_CONSUMER_I2C(I2C3, PB15, PB14, gpiob, 15, gpiob, 14)
    pinctrl-noinit;
};

&i2c4 {
    DEFINE_PINCTRL_CONSUMER_I2C(I2C4, PE02, PB00, gpioe, 2, gpiob, 0)
    pinctrl-noinit;
};

&i2cf1 {
    i2c = <&i2c1>;
    pinctrl-0 = <
        &i2cf1_scli_pb09
        &i2cf1_sdai_pb11
        &i2cf1_sclo_pb06
        &i2cf1_sdao_pb10
    >;
    pinctrl-names = "default";
};

&i2cf2 {
    i2c = <&i2c2>;
    pinctrl-0 = <
        &i2cf2_scli_pb05
        &i2cf2_sdai_pb03
        &i2cf2_sclo_pb04
        &i2cf2_sdao_pb01
    >;
    pinctrl-names = "default";
};

&i2cf3 {
    i2c = <&i2c3>;
    pinctrl-0 = <
        &i2cf3_sclo_pb15
        &i2cf3_sdao_pb14
        &i2cf3_scli_pb13
        &i2cf3_sdai_pb12
    >;
    pinctrl-names = "default";
};

&i2cf4 {
    i2c = <&i2c4>;
    pinctrl-0 = <
        &i2cf4_sclo_pe02
        &i2cf4_sdao_pb00
        &i2cf4_scli_pe03
        &i2cf4_sdai_pb02
    >;
    pinctrl-names = "default";
};

&spif1 {
    spi = <&spi3>;
    cs-gpios = <&gpioi 8 GPIO_ACTIVE_LOW>;
    pinctrl-0 = <
        &spif1_csn_in_pi10
        &spif1_clk_in_pg04
        &spif1_io0_in_pf14
        &spif1_io1_in_pg06
        &spif1_io2_in_ph00
        &spif1_io3_in_ph02
        &spif1_csn_out_pi08
        &spif1_clk_out_pg00
        &spif1_io0_out_pf15
        &spif1_io1_out_pf13
        &spif1_io2_out_ph01
        &spif1_io3_out_ph03
    >;
    pinctrl-1 = <
        &spif1_csn_in_pi10
        &spif1_clk_in_pg04
        &spif1_io0_in_pf14
        &spif1_io1_in_pg06
        &spif1_io2_in_ph00
        &spif1_io3_in_ph02

