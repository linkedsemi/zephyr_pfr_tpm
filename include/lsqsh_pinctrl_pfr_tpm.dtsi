    /omit-if-no-ref/spif1_csn_in_pi10: spif1_csn_in_pi10 {
        pinmux = <SPIF1_CSN_IN_FUNC2_PI10_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/i2cf4_sdao_pb00: i2cf4_sdao_pb00 {
        pinmux = <I2CF4_SDAO_FUNC3_PB00_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/i2cf2_sdao_pb01: i2cf2_sdao_pb01 {
        pinmux = <I2CF2_SDAO_FUNC3_PB01_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/i2cf4_sdai_pb02: i2cf4_sdai_pb02 {
        pinmux = <I2CF4_SDAI_FUNC3_PB02_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/i2cf2_sdai_pb03: i2cf2_sdai_pb03 {
        pinmux = <I2CF2_SDAI_FUNC3_PB03_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/i2cf2_sclo_pb04: i2cf2_sclo_pb04 {
        pinmux = <I2CF2_SCLO_FUNC3_PB04_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/i2cf2_scli_pb05: i2cf2_scli_pb05 {
        pinmux = <I2CF2_SCLI_FUNC3_PB05_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/i2cf1_sclo_pb06: i2cf1_sclo_pb06 {
        pinmux = <I2CF1_SCLO_FUNC3_PB06_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/i2cf1_scli_pb09: i2cf1_scli_pb09 {
        pinmux = <I2CF1_SCLI_FUNC3_PB09_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/i2cf1_sdao_pb10: i2cf1_sdao_pb10 {
        pinmux = <I2CF1_SDAO_FUNC3_PB10_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/i2cf1_sdai_pb11: i2cf1_sdai_pb11 {
        pinmux = <I2CF1_SDAI_FUNC3_PB11_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/i2cf3_sdai_pb12: i2cf3_sdai_pb12 {
        pinmux = <I2CF3_SDAI_FUNC3_PB12_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/i2cf3_scli_pb13: i2cf3_scli_pb13 {
        pinmux = <I2CF3_SCLI_FUNC3_PB13_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/i2cf3_sdao_pb14: i2cf3_sdao_pb14 {
        pinmux = <I2CF3_SDAO_FUNC3_PB14_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/i2cf3_sclo_pb15: i2cf3_sclo_pb15 {
        pinmux = <I2CF3_SCLO_FUNC3_PB15_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/i2cf4_sclo_pe02: i2cf4_sclo_pe02 {
        pinmux = <I2CF4_SCLO_FUNC3_PE02_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/i2cf4_scli_pe03: i2cf4_scli_pe03 {
        pinmux = <I2CF4_SCLI_FUNC3_PE03_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif2_csn_out_pg02: spif2_csn_out_pg02 {
        pinmux = <SPIF2_CSN_OUT_FUNC3_PG02_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif2_csn_in_pg03: spif2_csn_in_pg03 {
        pinmux = <SPIF2_CSN_IN_FUNC3_PG03_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif4_csn_out_pq00: spif4_csn_out_pq00 {
        pinmux = <SPIF4_CSN_OUT_FUNC3_PQ00_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/tpm_spis2_mosi_pq01: tpm_spis2_mosi_pq01 {
        pinmux = <TPM_SPIS2_MOSI_FUNC3_PQ01_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/tpm_spis2_miso_pq02: tpm_spis2_miso_pq02 {
        pinmux = <TPM_SPIS2_MISO_FUNC3_PQ02_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/tpm_spis2_sck_pq03: tpm_spis2_sck_pq03 {
        pinmux = <TPM_SPIS2_SCK_FUNC3_PQ03_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/tpm_spis2_csn_pq04: tpm_spis2_csn_pq04 {
        pinmux = <TPM_SPIS2_CSN_FUNC3_PQ04_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif4_csn_in_pq05: spif4_csn_in_pq05 {
        pinmux = <SPIF4_CSN_IN_FUNC3_PQ05_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif3_io1_in_pf02: spif3_io1_in_pf02 {
        pinmux = <SPIF3_IO1_IN_FUNC4_PF02_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif3_io1_out_pf03: spif3_io1_out_pf03 {
        pinmux = <SPIF3_IO1_OUT_FUNC4_PF03_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/spif3_io0_in_pf04: spif3_io0_in_pf04 {
