#include <zephyr/dt-bindings/pinctrl/lsqsh-pinctrl.h>
#include "lsqsh-pinctrl_pfr_tpm_func_pinctrl.h"
#include "lsqsh_clock_pfr_tpm.h"
#include "lsqsh_reset_pfr_tpm.h"
#include "dma_config.h"

/ {
    soc {
        i2cf1: i2cf@40090000 {
            compatible = "linkedsemi,i2c-filter";
            reg = <0x40090000 0x800>;
            interrupts = <155 3>;
            scl-hold-time = <0xfa>;
            clocks = <SMB_FLT1_CLOCK>;
            resets = <SMB_FLT1_RESET>;
            status = "disabled";
        };

        i2cf2: i2cf@40090800 {
            compatible = "linkedsemi,i2c-filter";
            reg = <0x40090800 0x800>;
            interrupts = <156 3>;
            scl-hold-time = <0xfa>;
            clocks = <SMB_FLT2_CLOCK>;
            resets = <SMB_FLT2_RESET>;
            status = "disabled";
        };

        i2cf3: i2cf@40091000 {
            compatible = "linkedsemi,i2c-filter";
            reg = <0x40091000 0x800>;
            interrupts = <157 3>;
            scl-hold-time = <0xfa>;
            clocks = <SMB_FLT3_CLOCK>;
            resets = <SMB_FLT3_RESET>;
            status = "disabled";
        };

        i2cf4: i2cf@40091800 {
            compatible = "linkedsemi,i2c-filter";
            reg = <0x40091800 0x800>;
            interrupts = <158 3>;
            scl-hold-time = <0xfa>;
            clocks = <SMB_FLT4_CLOCK>;
            resets = <SMB_FLT4_RESET>;
            status = "disabled";
        };

        spif1: spif@40070000 {
            compatible = "linkedsemi,spi-filter";
            reg = <0x40070000 0x2000>;
            interrupts = <71 3>;
            clocks = <SPI1_FLT_CLOCK>;
            resets = <SPI1_FLT_RESET>;
            dmas = <&dmac1 0 DMA_SPIFILTER1>;
            dma-names = "rx";
            index = <0>;
            status = "disabled";
        };
        spif2: spif@40072000 {
            compatible = "linkedsemi,spi-filter";
            reg = <0x40072000 0x2000>;
            interrupts = <72 3>;
            clocks = <SPI2_FLT_CLOCK>;
            resets = <SPI2_FLT_RESET>;
            dmas = <&dmac1 1 DMA_SPIFILTER2>;
            dma-names = "rx";
            index = <1>;
            status = "disabled";
        };
        spif3: spif@40074000 {
            compatible = "linkedsemi,spi-filter";
            reg = <0x40074000 0x2000>;
            interrupts = <73 3>;
            clocks = <SPI3_FLT_CLOCK>;
            resets = <SPI3_FLT_RESET>;
            dmas = <&dmac1 2 DMA_SPIFILTER3>;
            dma-names = "rx";
            index = <2>;
            status = "disabled";
        };
        spif4: spif@40076000 {
            compatible = "linkedsemi,spi-filter";
            reg = <0x40076000 0x2000>;
            interrupts = <74 3>;
            clocks = <SPI4_FLT_CLOCK>;
            resets = <SPI4_FLT_RESET>;
            dmas = <&dmac1 3 DMA_SPIFILTER4>;
            dma-names = "rx";
            index = <3>;
            status = "disabled";
        };

        tpm_spis1: tpm_spis@4000c000 {
            compatible = "linkedsemi,spid";
            reg = <0x4000c000 0x2000>;
            interrupts = <56 3>, <57 3>;
            interrupt-names = "main", "sysc";
            clocks = <TPM_SPIS1_CLOCK>;
            resets = <TPM_SPIS1_RESET>;
            status = "disabled";
        };

        tpm_spis2: tpm_spis@4000e000 {
            compatible = "linkedsemi,spid";
            reg = <0x4000e000 0x2000>;
            interrupts = <58 3>, <59 3>;
            interrupt-names = "main", "sysc";
            clocks = <TPM_SPIS2_CLOCK>;
            resets = <TPM_SPIS2_RESET>;
            status = "disabled";
        };
    };
};

&pinctrl {
    /omit-if-no-ref/spif3_csn_in_pi02: spif3_csn_in_pi02 {
        pinmux = <SPIF3_CSN_IN_FUNC2_PI02_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/tpm_spis1_miso_pi04: tpm_spis1_miso_pi04 {
        pinmux = <TPM_SPIS1_MISO_FUNC2_PI04_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/tpm_spis1_mosi_pi05: tpm_spis1_mosi_pi05 {
        pinmux = <TPM_SPIS1_MOSI_FUNC2_PI05_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/tpm_spis1_sck_pi06: tpm_spis1_sck_pi06 {
        pinmux = <TPM_SPIS1_SCK_FUNC2_PI06_PINMUX>;
        input-enable;
    };
    /omit-if-no-ref/tpm_spis1_csn_pi07: tpm_spis1_csn_pi07 {
        pinmux = <TPM_SPIS1_CSN_FUNC2_PI07_PINMUX>;
        input-enable;
