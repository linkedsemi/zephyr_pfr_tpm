#define SPI_FILTER_RETAIN_VAR_SIZE  0x3008
ASSERT((SPI_FILTER_RETAIN_VAR_SIZE % 4) == 0, "(SPI_FILTER_RETAIN_VAR_SIZE % 4) == 0")

#define SPI_FILTER_RETAIN_VAR_0_ADDR (DT_REG_ADDR_RAW(DT_NODELABEL(pfr_tpm)) + SPI_FILTER_RETAIN_VAR_SIZE * 0)
#define SPI_FILTER_RETAIN_VAR_1_ADDR (DT_REG_ADDR_RAW(DT_NODELABEL(pfr_tpm)) + SPI_FILTER_RETAIN_VAR_SIZE * 1)
#define SPI_FILTER_RETAIN_VAR_2_ADDR (DT_REG_ADDR_RAW(DT_NODELABEL(pfr_tpm)) + SPI_FILTER_RETAIN_VAR_SIZE * 2)
#define SPI_FILTER_RETAIN_VAR_3_ADDR (DT_REG_ADDR_RAW(DT_NODELABEL(pfr_tpm)) + SPI_FILTER_RETAIN_VAR_SIZE * 3)

#define PFR_TPM_SPI_FILTER_FILE_GLOB .noinit.*pfr_tpm/drivers/pfr/spi/spi_filter.c*
#define SPI_FILTER_RETAIN_VAR_SECTION_NAME(idx) UTIL_CAT(pfr_tpm_spi_filter_retain_var_, idx)
#define SPI_FILTER_RETAIN_VAR_NAME(dt) UTIL_CAT(spi_filter_retain_var_, DT_REG_ADDR_RAW(dt))
#define PFR_TPM_FIXED_NOINIT(sec_idx, sec_addr, var_name) \
    SPI_FILTER_RETAIN_VAR_SECTION_NAME(sec_idx) sec_addr (NOLOAD) : { KEEP(*(PFR_TPM_SPI_FILTER_FILE_GLOB.var_name)) } > PFR_TPM AT > PFR_TPM

PFR_TPM_FIXED_NOINIT(0, SPI_FILTER_RETAIN_VAR_0_ADDR, SPI_FILTER_RETAIN_VAR_NAME(DT_NODELABEL(spif1)))
PFR_TPM_FIXED_NOINIT(1, SPI_FILTER_RETAIN_VAR_1_ADDR, SPI_FILTER_RETAIN_VAR_NAME(DT_NODELABEL(spif2)))
PFR_TPM_FIXED_NOINIT(2, SPI_FILTER_RETAIN_VAR_2_ADDR, SPI_FILTER_RETAIN_VAR_NAME(DT_NODELABEL(spif3)))
PFR_TPM_FIXED_NOINIT(3, SPI_FILTER_RETAIN_VAR_3_ADDR, SPI_FILTER_RETAIN_VAR_NAME(DT_NODELABEL(spif4)))
